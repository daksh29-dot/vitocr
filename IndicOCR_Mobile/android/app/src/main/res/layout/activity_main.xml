<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="?android:attr/windowBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="14dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="44dp"
            android:layout_height="44dp"
            style="@style/Widget.AppCompat.Button.Borderless"
            android:background="@drawable/circle_button_light"
            android:src="@drawable/ic_back"
            android:scaleType="centerInside"
            android:padding="10dp"
            android:visibility="gone"/>

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1"/>

        <ImageButton
            android:id="@+id/btnOnlineToggle"
            android:layout_width="44dp"
            android:layout_height="44dp"
            style="@style/Widget.AppCompat.Button.Borderless"
            android:background="@drawable/circle_button_light"
            android:src="@drawable/ic_cloud_off"
            android:scaleType="centerInside"
            android:padding="10dp"
            android:layout_marginEnd="8dp"/>

        <ImageButton
            android:id="@+id/btnSettings"
            android:layout_width="44dp"
            android:layout_height="44dp"
            style="@style/Widget.AppCompat.Button.Borderless"
            android:background="@drawable/circle_button_light"
            android:src="@drawable/ic_settings"
            android:scaleType="centerInside"
            android:padding="10dp"
            android:layout_marginEnd="8dp"/>

        <ImageButton
            android:id="@+id/btnSearch"
            android:layout_width="44dp"
            android:layout_height="44dp"
            style="@style/Widget.AppCompat.Button.Borderless"
            android:background="@drawable/circle_button_light"
            android:src="@drawable/ic_search"
            android:scaleType="centerInside"
            android:padding="10dp"/>
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="2"
        android:layout_marginBottom="14dp">

        <androidx.cardview.widget.CardView
            android:id="@+id/cameraCard"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:cardCornerRadius="20dp"
            app:cardElevation="3dp"
            app:cardUseCompatPadding="false">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <androidx.camera.view.PreviewView
                    android:id="@+id/cameraPreview"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="#000000" >

                    <View
                        android:id="@+id/scanGrid"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_margin="40dp"
                        android:layout_gravity="center"
                        android:background="@drawable/scan_grid" />
                </androidx.camera.view.PreviewView>

            </FrameLayout>
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:id="@+id/previewCard"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            app:cardCornerRadius="20dp"
            app:cardElevation="3dp"
            app:cardUseCompatPadding="false">

            <ImageView
                android:id="@+id/imagePreview"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitCenter"
                android:background="?android:attr/windowBackground"/>
        </androidx.cardview.widget.CardView>
    </FrameLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="140dp"
        android:background="@drawable/rounded_card"
        android:elevation="2dp"
        android:layout_marginBottom="22dp"
        android:scrollbars="vertical"
        android:fadeScrollbars="false"
        android:backgroundTint="?attr/colorSurface">

        <TextView
            android:id="@+id/tvResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="64dp"
            android:padding="16dp"
            android:text="Point camera at text and tap Capture"
            android:textSize="17sp"
            android:textColor="?android:attr/textColorPrimary"
            android:gravity="center_vertical"
            android:lineSpacingExtra="4dp"/>
    </ScrollView>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:orientation="horizontal"
        android:background="@drawable/pill_toggle_bg"
        android:padding="4dp"
        android:layout_marginBottom="14dp">

        <TextView
            android:id="@+id/btnModeWord"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="22dp"
            android:paddingVertical="9dp"
            android:text="Word"
            android:textSize="14sp"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true"/>

        <TextView
            android:id="@+id/btnModePage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="22dp"
            android:paddingVertical="9dp"
            android:text="Page"
            android:textSize="14sp"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center">

        <ImageButton
            android:id="@+id/btnGallery"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginEnd="28dp"
            style="@style/Widget.AppCompat.Button.Borderless"
            android:background="@drawable/circle_button_light"
            android:src="@drawable/ic_gallery"
            android:scaleType="centerInside"
            android:padding="14dp"/>

        <ImageButton
            android:id="@+id/btnCapture"
            android:layout_width="76dp"
            android:layout_height="76dp"
            style="@style/Widget.AppCompat.Button.Borderless"
            android:background="@drawable/circle_button_primary"
            android:src="@drawable/ic_camera"
            android:scaleType="centerInside"
            android:padding="20dp"
            android:elevation="6dp"/>

        <ImageButton
            android:id="@+id/btnEval"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginStart="28dp"
            style="@style/Widget.AppCompat.Button.Borderless"
            android:background="@drawable/circle_button_light"
            android:src="@drawable/ic_folder"
            android:scaleType="centerInside"
            android:padding="14dp"/>
    </LinearLayout>

</LinearLayout>